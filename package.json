{
  "name": "scrcpy-desktop",
  "version": "1.0.0",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node src-server/server.js",
    "dev": "parcel public/index.html --dist-dir public/dev-dist --public-url /",
    "copy-broadway-files": "cpy node_modules/broadway-player/Player/Decoder.js public/dist/vendor/",
    "build:parcel": "parcel build public/index.html --dist-dir public/dist --public-url ./",
    "build": "npm-run-all clean build:parcel copy-broadway-files build:native",
    "build:native": "node-gyp configure --directory src-server/native && node-gyp build --directory src-server/native",
    "clean": "rimraf ./public/dist ./public/dev-dist ./.parcel-cache",
    "rebuild": "npm run build",
    "package:win": "node scripts/package-win.js",
    "package:linux": "node scripts/package-linux.js"
  },
  "keywords": [],
  "author": "serifpersia",
  "license": "MIT",
  "description": "Web application for scrcpy screen and audio streaming.",
  "dependencies": {
    "@devicefarmer/adbkit": "^3.3.8",
    "broadway-player": "^0.1.1",
    "cpy-cli": "^6.0.0",
    "express": "^5.1.0",
    "h264-converter": "^0.1.4",
    "nanoid": "^5.1.5",
    "node-dns-sd": "^1.0.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "parcel": "^2.15.4",
    "process": "^0.11.10",
    "rimraf": "^6.0.1",
    "svgo": "^4.0.0",
    "node-gyp": "^11.4.2",
    "node-addon-api": "^8.5.0",
    "fs-extra": "^11.3.1",
    "archiver": "^7.0.1"
  },
  "gypfile": true
}